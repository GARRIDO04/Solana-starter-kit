#[program]
pub mod playlist {
    use super::*;

    pub fn crear_playlist(context: Context<NuevaPlaylist>, nombre: String) -> Result<()> {
        let owner = context.accounts.owner.key();
        let canciones: Vec<Cancion> = Vec::new();

        context.accounts.playlist.set_inner(Playlist {
            owner,
            nombre,
            canciones,
        });

        Ok(())
    }

    pub fn agregar_cancion(context: Context<Cancion>, nombre: String, artista: String) -> Result<()> {
        let cancion = Cancion {
            nombre,
            artista,
            disponible: true,
        };

        context.accounts.playlist.canciones.push(cancion);

        Ok(())
    }

    pub fn ver_playlist(context: Context<VerPlaylist>) -> Result<()> {
        msg!(
            "La playlist es: {:#?}",
            context.accounts.playlist.canciones
        );

        Ok(())
    }

    pub fn eliminar_cancion(context: Context<NuevoLibro>, nombre: String) -> Result<()> {
        let libros = &mut context.accounts.biblioteca.libros;

        for playlist in 0..canciones.len() {
            if libros[libro].nombre == nombre {
                libros.remove(libro);
                msg!("Libro {nombre} eliminado!");
                return Ok(());
            }
        }

        Err(Errores::CancionNoExiste.into())
    }

    pub fn alternar_estado(context: Context<NuevoLibro>, nombre: String) -> Result<()> {
        let libros = &mut context.accounts.biblioteca.libros;

        for libro in 0..libros.len() {
            let estado = libros[libro].disponible;

            if libros[libro].nombre == nombre {
                let nuevo_estado = !estado;
                libros[libro].disponible = nuevo_estado;

                msg!(
                    "El libro: {} ahora tiene un valor de disponibilidad: {}",
                    nombre,
                    nuevo_estado
                );
                return Ok(());
            }
        }

        Err(Errores::LibroNoExiste.into())
    }
}

#[error_code]
pub enum Errores {
    #[msg("Error, no eres el propietario de la cuenta.")]
    NoEresElOwner,///

    #[msg("Error, el libro proporcionado no existe.")]
    LibroNoExiste,///
}

#[account]
#[derive(InitSpace)]
pub struct Playlist {
    owner: Pubkey,

    #[max_len(60)]
    nombre: String,

    #[max_len(10)]
    canciones: Vec<Cancion>,
}

#[derive(AnchorSerialize, AnchorDeserialize, Clone, InitSpace, PartialEq, Debug)]
pub struct Cancion {
    #[max_len(60)]
    nombre: String,

    arrista: String,

    disponible: bool,
}

#[derive(Accounts)]
pub struct NuevaPlaylist<'info> {
    #[account(mut)]
    pub owner: Signer<'info>,

    #[account(
        init,
        payer = owner,
        space = Playlist::INIT_SPACE + 8,
        seeds = [b"playlist", owner.key().as_ref()],
        bump
    )]
    pub playlist: Account<'info, Playlist>,

    pub system_program: Program<'info, System>,
}

#[derive(Accounts)]
pub struct VerPlaylist<'info> {
    pub owner: Signer<'info>,

    #[account(mut)]
    pub playlist: Account<'info, Playlist>,
}
